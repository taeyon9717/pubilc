#!name=腾讯文档小程序去广告
#!desc=仅拦截腾讯文档已知广告接口路径；不拦截微信通用素材域名，不修改文档内容。
#!author=taeyon9717
#!homepage=https://github.com/taeyon9717/pubilc
#!loon_version=3.5.1
#!tag=微信,腾讯文档,去广告
#!type=normal

# 腾讯文档广告接口路径（参考公开规则中已使用的精确路径匹配）
# 仅匹配 docs.qq.com 主机下的 /.../ad/ 与 /api/advertise/ 路径。
# 不按查询参数中的关键词拦截，降低误伤正常文档请求的风险。

[Rewrite]
request reject-ads if ${url} ~= /^https?:\\/\\/docs\\.qq\\.com\\/(?:(?:[^\\/?#]+\\/)+ad\\/|api\\/advertise\\/)/ then reject(404)

[Mitm]
hostname = docs.qq.com
