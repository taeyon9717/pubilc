[Script]
http-response ^https?:\/\/(?:httpdns|httpdnsvip|httpdnsmultiapi|httpdnsmultiapivip)\.meituan\.com\/ script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=拦截美团HTTPDNS请求
http-response ^http:\/\/103\.37\.155\.60\/fetch script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=拦截美团HTTPDNS请求
http-response ^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除首页底部标签
http-response ^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(?:gwc_feed1_2265|personalcenter_2154)(?:\?|$) script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除信息流广告
http-response ^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除个人中心广告
http-response ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除搜索默认词
http-response ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\/ script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除搜索热词
http-response ^https?:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除AI技能推荐
http-response ^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除购物车广告
http-response ^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture script-path=https://raw.githubusercontent.com/taeyon9717/pubilc/main/scripting/Meituan_remove_ads.js, requires-body=true, timeout=10, tag=移除开屏广告

[MitM]
hostname=apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com, httpdns.meituan.com, httpdnsmultiapi.meituan.com
